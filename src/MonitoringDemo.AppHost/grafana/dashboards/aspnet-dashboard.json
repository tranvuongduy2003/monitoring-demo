{
  "uid": "monitoring-demo",
  "title": "MonitoringDemo - API Metrics",
  "tags": ["metrics", "prometheus", "learning"],
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Counter - order throughput by status",
      "description": "A counter only increases. rate() converts its change into orders per second.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(rate(orders_created_total[$__rate_interval])) by (order_status)", "legendFormat": "{{order_status}}" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gauge - active orders",
      "description": "A gauge is a point-in-time value and can move up or down.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "active_orders", "legendFormat": "active" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Histogram percentiles - p50 / p95 / p99",
      "description": "histogram_quantile estimates percentiles from cumulative buckets.",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(order_processing_duration_ms_bucket[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(order_processing_duration_ms_bucket[$__rate_interval])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(order_processing_duration_ms_bucket[$__rate_interval])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Histogram count and sum",
      "description": "Every histogram exports _count and _sum in addition to _bucket series.",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(order_processing_duration_ms_count[$__rate_interval]))", "legendFormat": "observations/s" },
        { "refId": "B", "expr": "sum(rate(order_processing_duration_ms_sum[$__rate_interval]))", "legendFormat": "milliseconds/s" }
      ]
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Histogram bucket distribution",
      "description": "Explicit boundaries: 50, 100, 200, 500, 1000, and 2000 ms.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "targets": [{ "refId": "A", "expr": "sum(increase(order_processing_duration_ms_bucket[$__rate_interval])) by (le)", "format": "heatmap", "legendFormat": "{{le}}" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Observed label cardinality",
      "description": "Distinct status x category x source combinations. Keep labels bounded; never use order IDs.",
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 17 },
      "targets": [{ "refId": "A", "expr": "count(count by (order_status, product_category, traffic_source) (orders_created_total))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Histogram mean duration",
      "description": "Mean = rate(_sum) / rate(_count). This is not a percentile.",
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 17 },
      "targets": [{ "refId": "A", "expr": "sum(rate(order_processing_duration_ms_sum[$__rate_interval])) / sum(rate(order_processing_duration_ms_count[$__rate_interval]))" }],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP request time series",
      "description": "Each label set is an independent time series sampled over time.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_count[$__rate_interval])) by (http_response_status_code)", "legendFormat": "HTTP {{http_response_status_code}}" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Runtime gauges",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        { "refId": "A", "expr": "process_runtime_dotnet_gc_heap_size_bytes", "legendFormat": "GC heap" },
        { "refId": "B", "expr": "process_runtime_dotnet_thread_pool_threads_count", "legendFormat": "thread-pool threads" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Recording rule - order throughput",
      "description": "This query reads a precomputed series evaluated every 15 seconds instead of repeating the source aggregation.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "targets": [{ "refId": "A", "expr": "job:orders_created:rate5m", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Firing Prometheus alerts",
      "description": "Alerting rules become ALERTS time series while pending or firing.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 34 },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "The built-in up metric is 1 when the latest target scrape succeeded and 0 when it failed.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 34 },
      "targets": [{ "refId": "A", "expr": "sum(up)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    }
  ],
  "schemaVersion": 39,
  "version": 3
}
