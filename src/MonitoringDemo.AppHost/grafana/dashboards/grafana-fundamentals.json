{
  "uid": "grafana-fundamentals",
  "title": "Grafana Fundamentals",
  "description": "A provisioned learning dashboard for data sources, panels, queries, variables, annotations, Explore, and alerting.",
  "tags": ["grafana", "fundamentals", "learning"],
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source label",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(grafana_demo_query_runs_total, grafana_datasource)", "refId": "VariableQuery" },
        "definition": "label_values(grafana_demo_query_runs_total, grafana_datasource)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "interval",
        "label": "Aggregation interval",
        "type": "interval",
        "query": "1m,5m,15m,1h",
        "current": { "text": "5m", "value": "5m" }
      },
      {
        "name": "dashboard",
        "label": "Dashboard",
        "type": "custom",
        "query": "grafana-fundamentals,api-metrics,logs-correlation",
        "current": { "text": "grafana-fundamentals", "value": "grafana-fundamentals" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "loki", "uid": "loki" },
        "enable": true,
        "expr": "{service_name=\"MonitoringDemo.ApiService\"} |= `Grafana seed query failed`",
        "iconColor": "#8b5cf6",
        "name": "Seeded warning events",
        "tagKeys": "grafana,seed,error",
        "textFormat": "Grafana seeded query error"
      }
    ]
  },
  "links": [
    { "asDropdown": false, "icon": "external link", "includeVars": true, "keepTime": true, "tags": [], "targetBlank": false, "title": "Explore", "tooltip": "Open Grafana Explore", "type": "link", "url": "/explore" },
    { "asDropdown": false, "icon": "bell", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": false, "title": "Alert rules", "tooltip": "Open Grafana Alerting", "type": "link", "url": "/alerting/list" }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Queries in selected range",
      "description": "increase() converts the counter into the number of queries during the dashboard time range.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(grafana_demo_query_runs_total{grafana_datasource=~\"$datasource\"}[$__range]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Query success rate",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "1 - (sum(rate(grafana_demo_query_errors_total{grafana_datasource=~\"$datasource\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(grafana_demo_query_runs_total{grafana_datasource=~\"$datasource\"}[$__rate_interval])), 0.000001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }] } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "p95 query latency",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(grafana_demo_query_duration_ms_bucket{grafana_datasource=~\"$datasource\"}[$__rate_interval])))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "max": 1500, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 400 }, { "color": "red", "value": 800 }] } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active alerts",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(grafana_demo_active_alerts) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Query rate by data source · $datasource",
      "description": "$__rate_interval adapts to the panel resolution and Prometheus scrape interval.",
      "gridPos": { "h": 9, "w": 15, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (grafana_datasource) (rate(grafana_demo_query_runs_total{grafana_datasource=~\"$datasource\"}[$__rate_interval]))", "legendFormat": "{{grafana_datasource}}" }],
      "fieldConfig": { "defaults": { "unit": "qps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 18, "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Query totals by source",
      "gridPos": { "h": 9, "w": 9, "x": 15, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (grafana_datasource) (increase(grafana_demo_query_runs_total{grafana_datasource=~\"$datasource\"}[$__range]))", "instant": true, "format": "table" }],
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 7,
      "type": "heatmap",
      "title": "Query latency distribution",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (le) (rate(grafana_demo_query_duration_ms_bucket{grafana_datasource=~\"$datasource\"}[$__rate_interval]))", "format": "heatmap", "legendFormat": "{{le}}" }],
      "options": { "calculate": false, "yAxis": { "unit": "ms" }, "color": { "mode": "scheme", "scheme": "Oranges" } }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Grafana seed events",
      "description": "Structured seed logs can be correlated back to traces through trace_id and span_id fields.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "queryType": "range", "expr": "{service_name=\"MonitoringDemo.ApiService\"} |= `Grafana`" }],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" }
    }
  ],
  "schemaVersion": 41,
  "version": 1
}
