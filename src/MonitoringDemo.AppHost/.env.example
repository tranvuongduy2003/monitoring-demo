# Aspire environment
DOTNET_ENVIRONMENT=Development

# PostgreSQL development database
POSTGRES_PORT=5432
POSTGRES_DATABASE=monitoringdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Public host ports
FRONTEND_PORT=5173
API_PORT=5000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318

# Container images
GRAFANA_IMAGE_TAG=latest
PROMETHEUS_IMAGE_TAG=latest
LOKI_IMAGE_TAG=3.6.3
TEMPO_IMAGE_TAG=latest

# Monitoring retention
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s
PROMETHEUS_API_SCRAPE_INTERVAL=5s
PROMETHEUS_API_HOST=host.docker.internal
LOKI_RETENTION_PERIOD=168h

# Grafana development credentials. Blank URLs are derived from the ports above.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ALLOW_SIGN_UP=false
PROMETHEUS_DATASOURCE_URL=
LOKI_DATASOURCE_URL=
TEMPO_DATASOURCE_URL=

# API telemetry and browser access. Blank values are derived from the ports above.
LOKI_BASE_URL=
LOKI_OTLP_ENDPOINT=
TEMPO_OTLP_ENDPOINT=
PROMETHEUS_BASE_URL=
CORS_ALLOWED_ORIGINS=

# Links rendered by the frontend. Blank values are derived from the ports above.
VITE_API_PUBLIC_URL=
VITE_GRAFANA_URL=
VITE_PROMETHEUS_URL=
