{
  "uid": "fundamental-alerting",
  "title": "Fundamental Alerting",
  "description": "Threshold evaluation, Pending and Firing states, notification delivery, and fatigue analytics.",
  "tags": ["alerting", "thresholds", "notifications", "learning"],
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    { "asDropdown": false, "icon": "bell", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": false, "title": "Manage alert rules", "tooltip": "Open Grafana Alerting", "type": "link", "url": "/alerting/list" }
  ],
  "panels": [
    {
      "id": 1, "type": "row", "title": "Rule state", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": []
    },
    {
      "id": 2, "type": "stat", "title": "Pending rules",
      "description": "Threshold breached; waiting for the configured for duration.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(alerting_demo_active_instances{state=\"pending\"}) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "Firing rules",
      "description": "Sustained threshold breaches that have opened incidents.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(alerting_demo_active_instances{state=\"firing\"}) or vector(0)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Evaluations / second",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(alerting_demo_rule_evaluations_total[$__rate_interval]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "Signals evaluated against thresholds",
      "description": "Use the learning UI to seed healthy, pending, firing, or fatigue scenarios.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "alerting_demo_signal_value", "legendFormat": "{{rule}} ({{unit}})" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 12, "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 6, "type": "timeseries", "title": "Evaluations by state",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (state) (rate(alerting_demo_rule_evaluations_total[$__rate_interval]))", "legendFormat": "{{state}}" }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 45, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] }
    },
    {
      "id": 7, "type": "timeseries", "title": "Notification attempts by channel and status",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (channel, status) (increase(alerting_demo_notifications_total[$__rate_interval]))", "legendFormat": "{{channel}} · {{status}}" }],
      "fieldConfig": { "defaults": { "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 35, "lineWidth": 1 } }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Suppressed notification rate",
      "description": "Grouping and cooldowns reduce duplicate notification delivery.",
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(alerting_demo_suppressed_notifications_total[$__rate_interval]))" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 9, "type": "gauge", "title": "Alert fatigue ratio",
      "description": "Suppressed notification rate divided by all notification attempts.",
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(alerting_demo_suppressed_notifications_total[5m])) / clamp_min(sum(rate(alerting_demo_notifications_total[5m])), 0.001)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "red", "value": 0.4 }] } }, "overrides": [] }
    }
  ],
  "schemaVersion": 41,
  "version": 1
}
