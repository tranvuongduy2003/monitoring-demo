{
  "uid": "application-monitoring",
  "title": "Application Monitoring - Complete Request Path",
  "tags": ["application", "http", "database", "cache", "dependencies", "errors"],
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [{
    "name": "scenario", "label": "Scenario", "type": "query",
    "datasource": { "type": "prometheus", "uid": "prometheus" },
    "query": { "query": "label_values(application_http_requests_total, scenario)", "refId": "scenario-query" },
    "includeAll": true, "allValue": ".*", "current": { "text": "All", "value": "$__all" }
  }]},
  "panels": [
    { "id": 1, "type": "row", "title": "HTTP metrics", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    { "id": 2, "type": "timeseries", "title": "Requests by route", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 }, "targets": [{ "refId": "A", "expr": "sum by (http_route) (rate(application_http_requests_total{scenario=~\"$scenario\"}[$__rate_interval]))", "legendFormat": "{{http_route}}" }], "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] } },
    { "id": 3, "type": "timeseries", "title": "HTTP p95 latency", "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(application_http_request_duration_ms_bucket{scenario=~\"$scenario\"}[$__rate_interval])))", "legendFormat": "{{http_route}}" }], "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] } },
    { "id": 4, "type": "timeseries", "title": "HTTP server errors", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 }, "targets": [{ "refId": "A", "expr": "sum by (http_route) (rate(application_http_request_errors_total{scenario=~\"$scenario\"}[$__rate_interval]))", "legendFormat": "{{http_route}}" }] },

    { "id": 5, "type": "row", "title": "Database metrics", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }, "panels": [] },
    { "id": 6, "type": "timeseries", "title": "Database operations", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 }, "targets": [{ "refId": "A", "expr": "sum by (db_operation_name) (rate(application_database_operations_total{scenario=~\"$scenario\"}[$__rate_interval]))", "legendFormat": "{{db_operation_name}}" }] },
    { "id": 7, "type": "timeseries", "title": "Database p95 latency", "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, db_operation_name) (rate(application_database_operation_duration_ms_bucket{scenario=~\"$scenario\"}[$__rate_interval])))", "legendFormat": "{{db_operation_name}}" }], "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] } },

    { "id": 8, "type": "row", "title": "Cache metrics", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "panels": [] },
    { "id": 9, "type": "gauge", "title": "Cache hit ratio", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 17 }, "targets": [{ "refId": "A", "expr": "sum(rate(application_cache_operations_total{scenario=~\"$scenario\",cache_outcome=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(application_cache_operations_total{scenario=~\"$scenario\",cache_outcome=~\"hit|miss\"}[$__rate_interval])), 0.001)" }], "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.6 }, { "color": "green", "value": 0.8 }] } }, "overrides": [] } },
    { "id": 10, "type": "timeseries", "title": "Cache outcomes", "gridPos": { "h": 7, "w": 8, "x": 8, "y": 17 }, "targets": [{ "refId": "A", "expr": "sum by (cache_outcome) (rate(application_cache_operations_total{scenario=~\"$scenario\"}[$__rate_interval]))", "legendFormat": "{{cache_outcome}}" }] },
    { "id": 11, "type": "timeseries", "title": "Cache p95 latency", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 17 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(application_cache_operation_duration_ms_bucket{scenario=~\"$scenario\"}[$__rate_interval])))" }], "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] } },

    { "id": 12, "type": "row", "title": "Dependency monitoring", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }, "panels": [] },
    { "id": 13, "type": "timeseries", "title": "Calls by dependency", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 25 }, "targets": [{ "refId": "A", "expr": "sum by (server_address) (rate(application_dependency_calls_total{scenario=~\"$scenario\"}[$__rate_interval]))", "legendFormat": "{{server_address}}" }] },
    { "id": 14, "type": "timeseries", "title": "Dependency failures", "gridPos": { "h": 7, "w": 8, "x": 8, "y": 25 }, "targets": [{ "refId": "A", "expr": "sum by (server_address) (rate(application_dependency_call_errors_total{scenario=~\"$scenario\"}[$__rate_interval]))", "legendFormat": "{{server_address}}" }] },
    { "id": 15, "type": "timeseries", "title": "Dependency p95 latency", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 25 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, server_address) (rate(application_dependency_call_duration_ms_bucket{scenario=~\"$scenario\"}[$__rate_interval])))", "legendFormat": "{{server_address}}" }], "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] } },

    { "id": 16, "type": "row", "title": "Custom metrics", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "panels": [] },
    { "id": 17, "type": "timeseries", "title": "Business events", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 33 }, "targets": [{ "refId": "A", "expr": "sum by (business_event) (rate(application_business_events_total{scenario=~\"$scenario\"}[$__rate_interval]))", "legendFormat": "{{business_event}}" }] },
    { "id": 18, "type": "timeseries", "title": "Queue depth", "gridPos": { "h": 7, "w": 12, "x": 12, "y": 33 }, "targets": [{ "refId": "A", "expr": "application_queue_depth", "legendFormat": "queued items" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },

    { "id": 19, "type": "row", "title": "Custom spans", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }, "panels": [] },
    { "id": 20, "type": "timeseries", "title": "Custom span throughput", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 41 }, "targets": [{ "refId": "A", "expr": "sum by (span_name, outcome) (rate(application_custom_spans_total{scenario=~\"$scenario\"}[$__rate_interval]))", "legendFormat": "{{span_name}} {{outcome}}" }] },
    { "id": 21, "type": "timeseries", "title": "Custom span p95 latency", "gridPos": { "h": 7, "w": 12, "x": 12, "y": 41 }, "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(application_custom_span_duration_ms_bucket{scenario=~\"$scenario\"}[$__rate_interval])))", "legendFormat": "{{span_name}}" }], "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] } },

    { "id": 22, "type": "row", "title": "Error monitoring", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 }, "panels": [] },
    { "id": 23, "type": "timeseries", "title": "Errors by source and type", "gridPos": { "h": 7, "w": 24, "x": 0, "y": 49 }, "targets": [{ "refId": "A", "expr": "sum by (error_source, error_type, severity) (rate(application_errors_total{scenario=~\"$scenario\"}[$__rate_interval]))", "legendFormat": "{{error_source}} / {{error_type}} / {{severity}}" }] }
  ],
  "schemaVersion": 39,
  "version": 1
}
