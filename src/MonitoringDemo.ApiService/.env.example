# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Used when the API is run without Aspire. Aspire injects its own connection string.
ConnectionStrings__monitoringdb=Host=localhost;Port=5432;Database=monitoringdb;Username=postgres;Password=change-me

# Comma-separated browser origins. Use * only for local development.
Cors__AllowedOrigins=http://localhost:5173

# Loki query and OpenTelemetry log export endpoints
Loki__BaseUrl=http://localhost:3100
LOKI_OTLP_ENDPOINT=http://localhost:3100/otlp/v1/logs
# Tempo OTLP/HTTP trace export endpoint
TEMPO_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Optional standard OTLP/gRPC exporter settings. Signal-specific values take
# precedence over OTEL_EXPORTER_OTLP_ENDPOINT when the exporter is enabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
# Tempo HTTP API used by the distributed tracing dashboard
Tempo__BaseUrl=http://localhost:3200
# Prometheus API used by the learning dashboard
Prometheus__BaseUrl=http://localhost:9090
Prometheus__Retention=15d
Prometheus__ScrapeInterval=15s
Prometheus__ApiScrapeInterval=5s
Prometheus__EvaluationInterval=15s
